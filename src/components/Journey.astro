---
/**
 * Journey: timeline of work and education. From 900px the section header (kicker, H2, 15px intro)
 * sits in a sticky 200px left column beside the timeline; below 900px everything is one column.
 * The timeline is an <ol> with a 1px line on its left; each item has a 13px dot centered on that
 * line and aligned with its first text line (the mono period row):
 *   current        → cobalt fill with a 3px mist ring
 *   past work      → white fill, 3px cobalt border
 *   education      → white fill, 3px text border
 * An optional `orgNote` (e.g. the contracting company) follows the org in the H3 as muted 15px
 * regular-weight text, so the entry still reads as one engagement.
 *
 * Scroll story (screen, motion allowed, JS): a cobalt line (the <ol>'s ::before) draws down over the
 * gray track as the page scrolls, scrubbed by ScrollTrigger so its tip stays 60% down the viewport.
 * When the tip reaches an item's dot, the item activates once: the dot scales in with a cobalt
 * pulse, then the period, the H3 and the description slide in 12px from the line, 80ms apart.
 * Items whose dot is already above that line when the script runs stay as rendered.
 * Everything is opacity/transform, so nothing moves layout. The start states only apply once the
 * script has armed the list, on screen, with motion allowed: without JS, in print, or under
 * prefers-reduced-motion (even if switched on mid-visit) the line is fully drawn and every item is
 * static in its final state.
 */
import Section from './ui/Section.astro';
import { getContent, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);
const header = content.sections.journey;

const dotKind = (item: (typeof content.journey)[number]) =>
  item.current ? 'current' : item.type === 'education' ? 'education' : 'past';
---

<Section
  id="journey"
  locale={locale}
  kicker={header.kicker}
  title={header.title}
  intro={header.intro}
  layout="aside"
>
  <ol class="journey relative border-l border-line" data-journey>
    {
      content.journey.map((item) => (
        <li class="journey-item relative pb-10 pl-10 last:pb-0" data-dot={dotKind(item)}>
          <span class="journey-dot" aria-hidden="true" />
          <p class:list={['font-mono text-mono', item.current ? 'text-cobalt' : 'text-muted']}>
            {item.period}
            {item.place && ` · ${item.place}`}
          </p>
          <h3 class="mt-1 text-[20px] leading-[1.3] font-semibold tracking-[-0.01em]">
            {item.title} · {item.org}
            {item.orgNote && ' '}
            {item.orgNote && (
              <span class="text-body-sm font-normal tracking-normal whitespace-nowrap text-muted" data-org-note>
                {item.orgNote}
              </span>
            )}
          </h3>
          <p class="mt-2 max-w-[62ch] text-body-sm text-muted">{item.description}</p>
        </li>
      ))
    }
  </ol>
</Section>


<style>
  .journey-dot {
    position: absolute;
    /* Centered on the <ol>'s 1px left border, which sits just outside the item's box. */
    left: calc(-6.5px - 0.5px);
    /* Vertically centered on the first line: mono 13px at line-height 1.4. */
    top: calc((var(--text-mono) * 1.4 - 13px) / 2);
    width: 13px;
    height: 13px;
    border-radius: 9999px;
    background-color: var(--color-surface);
    border: 3px solid var(--color-cobalt);
  }

  [data-dot='current'] .journey-dot {
    background-color: var(--color-cobalt);
    border: 0;
    box-shadow: 0 0 0 3px var(--color-mist);
  }

  [data-dot='education'] .journey-dot {
    border-color: var(--color-text);
  }

  /* The drawn line, laid over the <ol>'s 1px gray border (the track). Fully drawn by default. */
  .journey::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -1px;
    width: 1px;
    background-color: var(--color-cobalt);
    transform-origin: top;
    pointer-events: none;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    .journey[data-journey-armed]::before {
      transform: scaleY(var(--journey-progress, 1));
    }

    /* Start states. Arming hides pending items instantly (no transition until .is-active), and
       only items below the line are ever pending, so nothing on screen disappears. */
    [data-journey-pending]:not(.is-active) > .journey-dot {
      transform: scale(0);
    }

    [data-journey-pending]:not(.is-active) > :not(.journey-dot) {
      opacity: 0;
      transform: translateX(-12px);
    }

    [data-journey-pending].is-active > * {
      transition:
        opacity 480ms var(--ease-out) var(--journey-delay, 0ms),
        transform 480ms var(--ease-out) var(--journey-delay, 0ms);
    }

    [data-journey-pending].is-active > .journey-dot {
      transition: transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    [data-journey-pending].is-active > :nth-child(2) {
      --journey-delay: 80ms;
    }

    [data-journey-pending].is-active > :nth-child(3) {
      --journey-delay: 160ms;
    }

    [data-journey-pending].is-active > :nth-child(4) {
      --journey-delay: 240ms;
    }

    /* Accent pulse: a ring that expands from the dot's outer edge and fades. */
    [data-journey-pending].is-active > .journey-dot::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 13px;
      height: 13px;
      translate: -50% -50%;
      border-radius: 9999px;
      pointer-events: none;
      animation: journey-pulse 760ms var(--ease-out) 140ms both;
    }

    @keyframes journey-pulse {
      from {
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-cobalt) 55%, transparent);
      }
      to {
        box-shadow: 0 0 0 12px color-mix(in srgb, var(--color-cobalt) 0%, transparent);
      }
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  /** The line's tip, and the point where an item activates, as % of the viewport height. */
  const TIP = 60;

  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

  if (motionOk) {
    gsap.registerPlugin(ScrollTrigger);
    const tipY = (window.innerHeight * TIP) / 100;

    for (const list of document.querySelectorAll<HTMLOListElement>('[data-journey]')) {
      // Decide which items are still ahead of the line before arming, so the list never repaints
      // with an item that was already in place.
      const pending = [...list.querySelectorAll<HTMLElement>('.journey-item')].filter((item) => {
        const dot = item.querySelector('.journey-dot')!.getBoundingClientRect();
        return dot.top + dot.height / 2 > tipY;
      });

      list.dataset.journeyArmed = '';
      // Start == end offset, so the tip of the drawn line sits exactly on the TIP line.
      gsap.fromTo(
        list,
        { '--journey-progress': 0 },
        {
          '--journey-progress': 1,
          ease: 'none',
          scrollTrigger: { trigger: list, start: `top ${TIP}%`, end: `bottom ${TIP}%`, scrub: true },
        },
      );

      for (const item of pending) {
        item.dataset.journeyPending = '';
        ScrollTrigger.create({
          // The dot scales around its centre, so its centre is the same in both states.
          trigger: item.querySelector('.journey-dot'),
          start: `center ${TIP}%`,
          once: true,
          onEnter: () => item.classList.add('is-active'),
        });
      }
    }
  }
</script>
