---
/**
 * Skills: four accent cards — 4 columns from 1200px, 2×2 from 900px, 1 column below.
 * Cards in a row share the tallest height; chips sit at the bottom of each card.
 */
import Card from './ui/Card.astro';
import Chip from './ui/Chip.astro';
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import { getContent, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);
const header = content.sections.skills;
---

<Section
  id="skills"
  locale={locale}
  kicker={header.kicker}
  title={header.title}
  intro={header.intro}
  padding="bottom"
>
  <ul class="grid gap-gutter md:grid-cols-2 lg:grid-cols-4">
    {
      content.skills.map((skill) => (
        <li class="flex">
          <Card as="article" topAccent class="flex w-full flex-col gap-4">
            <Icon name={skill.icon} size={28} class="text-cobalt" />
            <h3 class="text-h3-sm font-semibold tracking-[-0.01em]">{skill.title}</h3>
            <p class="text-body-sm text-muted">{skill.description}</p>
            <ul class="mt-auto flex flex-wrap gap-[6px]">
              {skill.chips.map((chip) => (
                <li class="max-w-full">
                  <Chip wrap>{chip}</Chip>
                </li>
              ))}
            </ul>
          </Card>
        </li>
      ))
    }
  </ul>
</Section>
