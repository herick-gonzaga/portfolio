---
/**
 * Skills: four accent cards — 2×2 from 900px, 1 column below.
 * No 4-column row: with 6–10 chips per card, the longest chips ("Agentes de código
 * (Claude Code)", ~280px) overflow a 4-column card even at the 1248px max container.
 * Cards in a row share the tallest height; chips sit at the bottom of each card.
 */
import Card from './ui/Card.astro';
import Chip from './ui/Chip.astro';
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import { getContent, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);
const header = content.sections.skills;
---

<Section
  id="skills"
  locale={locale}
  kicker={header.kicker}
  title={header.title}
  intro={header.intro}
  padding="bottom"
>
  <ul class="grid gap-gutter md:grid-cols-2" data-reveal-group>
    {
      content.skills.map((skill) => (
        <li class="flex" data-reveal>
          <Card as="article" topAccent class="flex w-full flex-col gap-4">
            <Icon name={skill.icon} size={28} class="text-cobalt" />
            <h3 class="text-h3-sm font-semibold tracking-[-0.01em]">{skill.title}</h3>
            <p class="text-body-sm text-muted">{skill.description}</p>
            <ul class="mt-auto flex flex-wrap gap-[6px]">
              {skill.chips.map((chip) => (
                <li>
                  <Chip>{chip}</Chip>
                </li>
              ))}
            </ul>
          </Card>
        </li>
      ))
    }
  </ul>
</Section>
