---
/**
 * Interactive terminal, the last block of the Contact section (on ink, below the two columns).
 * A shell window: title bar with traffic-light dots, then a scrolling body (352px, 320px below
 * 600px) holding the output log and the `herick@portfolio:~$` prompt with a blinking block cursor,
 * all in JetBrains Mono. Below it, quick-command buttons for visitors who'd rather tap than type.
 *
 * Every line a command prints is built here, from the locale's content, and shipped as a JSON data
 * block; src/scripts/terminal.ts renders it. The script below is only a bootstrap: it loads that
 * module the first time the terminal scrolls into view (and then runs `help` once) or is focused,
 * pressed or submitted, whichever comes first.
 *
 * Accessibility: the window is a labelled group; the output is role="log" aria-live="polite"; the
 * input has a visually hidden label and tabindex="0" (one Tab stop, in document order); Tab only
 * completes a partial command and otherwise moves focus. The body is wheel-scrollable on its own
 * (data-lenis-prevent) and never scrolls the page.
 */
import { getContent, type Locale } from '../i18n';
import type { TerminalCommand } from '../i18n/types';
import type { Line, Segment, TerminalData } from '../scripts/terminal';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { profile, ui, terminal: t, skills, projects, journey } = getContent(locale);
const { contact } = profile;

const PROMPT = 'herick@portfolio:~$';
const COMMANDS = Object.keys(t.commands) as TerminalCommand[];
const QUICK: TerminalCommand[] = ['help', 'about', 'skills', 'projects', 'journey', 'contact', 'languages', 'sudo hire-me'];

/** Splits a string on `{help}` and highlights the command. */
const withHelp = (text: string): Line =>
  text.split(/(\{help\})/).filter(Boolean).map((part): Segment => (part === '{help}' ? { t: 'help', k: 'cmd' } : { t: part }));

const pad = (labels: string[]) => {
  const width = Math.max(...labels.map((l) => l.length)) + 2;
  return (label: string) => label.padEnd(width, ' ');
};

const padCommand = pad(COMMANDS);
const padContact = pad([ui.contact.email, ui.contact.linkedin, ui.contact.github]);
const padLanguage = pad(t.languages.map((l) => l.name));
const blank: Line = [];
const mailto = (subject?: string) => `mailto:${contact.email}${subject ? `?subject=${encodeURIComponent(subject)}` : ''}`;

const outputs: Record<Exclude<TerminalCommand, 'clear'>, Line[]> = {
  help: [
    ...COMMANDS.map((name): Line => [{ t: padCommand(name), k: 'cmd' }, { t: t.commands[name] }]),
    blank,
    [{ t: t.helpTip, k: 'muted' }],
  ],
  about: t.about.map((line, i): Line => [{ t: line, k: i === 0 ? 'accent' : undefined }]),
  skills: skills.flatMap((group, i): Line[] => [
    ...(i ? [blank] : []),
    [{ t: `# ${group.title}`, k: 'accent' }],
    group.chips.map((chip): Segment => ({ t: chip, k: 'tag' })),
  ]),
  projects: projects.map((project): Line => [
    { t: '▸ ', k: 'muted' },
    { t: project.name, k: 'accent' },
    { t: ` — ${project.tagline}` },
  ]),
  journey: journey.flatMap((item, i): Line[] => [
    ...(i ? [blank] : []),
    [{ t: item.current ? '● ' : '○ ', k: item.current ? 'ok' : 'muted' }, { t: item.period, k: 'muted' }],
    [{ t: '  ' }, { t: item.title }, { t: ` · ${item.org}`, k: 'accent' }],
  ]),
  contact: [
    [{ t: padContact(ui.contact.email), k: 'muted' }, { t: contact.email, href: mailto() }],
    [{ t: padContact(ui.contact.linkedin), k: 'muted' }, { t: contact.linkedinLabel, href: contact.linkedin, ext: true }],
    [{ t: padContact(ui.contact.github), k: 'muted' }, { t: contact.githubLabel, href: contact.github, ext: true }],
  ],
  languages: t.languages.map((l): Line => [{ t: padLanguage(l.name), k: 'accent' }, { t: l.level }]),
  'sudo hire-me': [
    ...t.hire.map((line, i): Line => [{ t: line, k: i === t.hire.length - 1 ? 'ok' : 'muted' }]),
    [{ t: `${t.hireOpening} ` }, { t: contact.email, href: mailto(t.hireSubject) }],
  ],
};

const data: TerminalData = {
  prompt: PROMPT,
  commands: COMMANDS,
  outputs,
  notFound: t.notFound,
  notFoundHint: withHelp(t.notFoundHint),
  hireMail: mailto(t.hireSubject),
};
---

<div class="terminal-block mt-16 md:mt-24" data-terminal data-reveal>
  <p class="font-mono text-mono text-muted-dark" id="terminal-intro">{t.intro}</p>

  <div class="terminal mt-4" role="group" aria-label={t.label} aria-describedby="terminal-intro">
    <div class="terminal-bar" aria-hidden="true">
      <span class="terminal-dots">
        <span class="terminal-dot bg-[var(--color-term-red)]"></span>
        <span class="terminal-dot bg-[var(--color-term-yellow)]"></span>
        <span class="terminal-dot bg-[var(--color-term-green)]"></span>
      </span>
      <span class="terminal-title">herick@portfolio: ~</span>
    </div>

    <div class="terminal-body" data-terminal-body data-lenis-prevent>
      <div role="log" aria-live="polite" aria-label={t.label} data-terminal-log>
        <p class="t-line">
          {withHelp(t.welcome).map((seg) => <span class:list={[seg.k && `t-${seg.k}`]}>{seg.t}</span>)}
        </p>
      </div>
      <form class="t-prompt" data-terminal-form>
        <label for={`terminal-input-${locale}`} class="sr-only">{t.inputLabel}</label>
        <span class="t-ok shrink-0" aria-hidden="true">{PROMPT}</span>
        <span class="t-field">
          <input
            id={`terminal-input-${locale}`}
            class="t-input"
            type="text"
            tabindex="0"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="go"
            data-terminal-input
          />
          <span class="t-mirror" aria-hidden="true" data-terminal-mirror></span>
          <span class="t-cursor" aria-hidden="true" data-terminal-cursor></span>
        </span>
      </form>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <span id="terminal-quick" class="mr-1 font-mono text-mono-sm text-muted-dark">{t.quick}</span>
    {
      QUICK.map((name) => (
        <button
          type="button"
          class="inline-flex min-h-touch items-center rounded-chip border border-ink-border bg-ink-surface px-3 font-mono text-mono-sm whitespace-nowrap text-muted-dark transition-colors duration-hover ease-out hover:border-cobalt-soft hover:text-white md:min-h-chip"
          aria-describedby="terminal-quick"
          data-terminal-run={name}
        >
          {name}
        </button>
      ))
    }
  </div>

  <script type="application/json" data-terminal-data set:html={JSON.stringify(data)} />
</div>

<script>
  import type { TerminalController } from '../scripts/terminal';

  const root = document.querySelector<HTMLElement>('[data-terminal]');
  if (root) {
    let controller: Promise<TerminalController> | undefined;
    const start = () => (controller ??= import('../scripts/terminal').then(({ mount }) => mount(root)));

    // First interaction: focusing the prompt (or anything inside) or pressing on the window.
    root.addEventListener('focusin', start, { once: true });
    root.addEventListener('pointerdown', start, { once: true });

    // The form always belongs to the bootstrap, so Enter works even before the module arrives.
    root.querySelector('[data-terminal-form]')!.addEventListener('submit', (event) => {
      event.preventDefault();
      start().then((c) => c.submit());
    });

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-terminal-run]')) {
      button.addEventListener('click', () => start().then((c) => c.run(button.dataset.terminalRun!)));
    }

    // First time the window is mostly in view: load, and run `help` once.
    const windowEl = root.querySelector('.terminal')!;
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        start().then((c) => c.autoHelp());
      },
      { threshold: 0.5 },
    );
    observer.observe(windowEl);
  }
</script>

<style>
  .terminal {
    overflow: hidden;
    border: 1px solid var(--color-ink-border);
    border-radius: var(--radius-card);
    background-color: var(--color-term-bg);
    box-shadow: 0 24px 64px rgb(0 0 0 / 0.35);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-term-text);
  }

  .terminal-bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 40px;
    padding-inline: 16px;
    border-bottom: 1px solid var(--color-ink-line);
    background-color: var(--color-ink-surface);
  }

  .terminal-dots {
    display: flex;
    gap: 8px;
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 9999px;
  }

  .terminal-title {
    position: absolute;
    inset-inline: 76px;
    overflow: hidden;
    font-size: 12px;
    color: var(--color-muted-dark);
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /*
   * A flex column whose log grows: while the output is shorter than the body, the prompt sits at
   * the bottom and new lines fill the space above it, so nothing already on screen moves (no
   * layout shift). Once the output overflows, the body scrolls and stays pinned to the bottom.
   */
  .terminal-body {
    display: flex;
    flex-direction: column;
    height: 352px;
    padding: 16px 20px 20px;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-color: var(--color-ink-border) transparent;
    scrollbar-width: thin;
    cursor: text;
  }

  /* Lines wrap anywhere so the body never scrolls sideways; spacing in padded columns is kept. */
  .terminal-body :global(.t-line) {
    min-height: 1.6em;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .terminal-body :global(.t-echo) {
    margin-top: 12px;
  }

  .terminal-body :global(.t-cmd) {
    color: var(--color-term-cmd);
  }

  .terminal-body :global(.t-muted) {
    color: var(--color-muted-dark);
  }

  .terminal-body :global(.t-accent) {
    color: var(--color-cobalt-soft);
  }

  .terminal-body :global(.t-ok) {
    color: var(--color-signal);
  }

  .terminal-body :global(.t-tag) {
    display: inline-block;
    margin: 4px 6px 0 0;
    padding: 0 8px;
    border: 1px solid var(--color-ink-border);
    border-radius: var(--radius-chip);
    font-size: 12px;
    line-height: 22px;
    white-space: nowrap;
    color: var(--color-term-tag);
  }

  .terminal-body :global(.t-link) {
    border-radius: 2px;
    color: var(--color-term-link);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--duration-hover) ease-out;
  }

  .terminal-body :global(.t-link:hover) {
    color: var(--color-term-text);
  }

  [data-terminal-log] {
    flex: 1 0 auto;
  }

  .t-prompt {
    display: flex;
    gap: 1ch;
    align-items: center;
    margin-top: 12px;
  }

  .t-field {
    position: relative;
    display: flex;
    flex: 1;
    min-width: 0;
    align-items: center;
  }

  .t-input {
    width: 100%;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: transparent;
    font: inherit;
    color: inherit;
    caret-color: transparent;
  }

  /* Same font as the input, invisible: its width is where the block cursor goes. */
  .t-mirror {
    position: absolute;
    top: 0;
    left: 0;
    visibility: hidden;
    font: inherit;
    white-space: pre;
  }

  .t-cursor {
    position: absolute;
    top: 50%;
    left: 0;
    width: 1ch;
    height: 1.25em;
    margin-top: -0.625em;
    background-color: var(--color-term-text);
    pointer-events: none;
    animation: terminal-blink 1.1s steps(1, end) infinite;
  }

  .t-input:not(:focus) ~ .t-cursor {
    background-color: transparent;
    box-shadow: inset 0 0 0 1px var(--color-term-text);
  }

  @keyframes terminal-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .t-cursor {
      animation: none;
    }
  }

  /* Below 600px: a shorter body, and a 16px input so iOS doesn't zoom in on focus. */
  @media (max-width: 599.98px) {
    .terminal-body {
      height: 320px;
      padding: 12px 14px 16px;
    }

    .t-input,
    .t-mirror {
      font-size: 16px;
    }
  }
</style>
