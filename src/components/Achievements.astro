---
/**
 * Achievements & impact (id "impact"): shares the mist background with Journey above, so only the
 * bottom padding is kept.
 * Row 1: three metric cards (one column below 600px). Each value is the first line of its card at
 * a fixed 44px/1 line box (36px/1 between 600px and 900px, where three columns are too narrow for a
 * value like "98.85%"), so the values share one baseline whatever the label wrapping below.
 * Metric values are rendered as-is from the locale files, which own the per-locale number format.
 * Row 2: the achievement cards in two columns from 900px (one below), icon left of the text.
 */
import Card from './ui/Card.astro';
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import { getContent, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);
const header = content.sections.impact;
const { metrics, items } = content.achievements;
---

<Section
  id="impact"
  locale={locale}
  kicker={header.kicker}
  title={header.title}
  intro={header.intro}
  padding="bottom"
>
  <ul class="grid gap-gutter sm:grid-cols-3" data-metrics data-reveal-group>
    {
      metrics.map((metric) => (
        <li class="flex" data-reveal>
          <Card spotlight class="flex w-full flex-col">
            <p class="text-metric font-semibold sm:max-md:text-[36px] tracking-[-0.03em] text-cobalt">{metric.value}</p>
            <p class="mt-3 text-[15px] leading-[1.4] font-semibold">{metric.label}</p>
            <p class="mt-2 text-[14px] leading-[1.5] text-muted">{metric.note}</p>
          </Card>
        </li>
      ))
    }
  </ul>

  <ul class="mt-gutter grid gap-gutter md:grid-cols-2" data-achievements data-reveal-group>
    {
      items.map((item) => (
        <li class="flex" data-reveal>
          <Card as="article" spotlight class="flex w-full gap-5">
            <Icon name={item.icon} size={24} class="mt-[2px] shrink-0 text-cobalt" />
            <div>
              <h3 class="text-[17px] leading-[1.35] font-semibold">{item.title}</h3>
              <p class="mt-1.5 text-[14px] leading-[1.55] text-muted">{item.description}</p>
            </div>
          </Card>
        </li>
      ))
    }
  </ul>
</Section>
