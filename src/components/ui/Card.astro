---
/**
 * Card: surface + 1px line border, radius 12, padding 32 (24 below 900px).
 * `dark` switches to ink with an ink-line border; `topAccent` adds a 3px cobalt top border.
 * `padding="list"` keeps the horizontal padding but uses 8px vertical padding (row lists).
 * `padding="featured"` uses 40px from 900px (24px below), for the featured project.
 * Hover lifts 2px with the spec's single shadow; no hover motion under prefers-reduced-motion.
 * `reveal` marks the card for the scroll reveal (data-reveal, see src/scripts/motion.ts).
 */
import type { HTMLTag } from 'astro/types';

interface Props {
  as?: HTMLTag;
  dark?: boolean;
  topAccent?: boolean;
  padding?: 'default' | 'list' | 'featured';
  /** Fade the card in when it scrolls into view (src/scripts/motion.ts). */
  reveal?: boolean;
  class?: string;
}

const { as: Tag = 'div', dark = false, topAccent = false, padding = 'default', reveal = false, class: className } = Astro.props;
---

<Tag
  class:list={[
    'card rounded-card border',
    dark ? 'border-ink-line bg-ink text-white' : 'border-line bg-surface text-text',
    topAccent && 'border-t-[3px] border-t-cobalt',
    { default: 'p-6 md:p-card', list: 'px-6 py-2 md:px-card', featured: 'p-6 md:p-10' }[padding],
    className,
  ]}
  data-reveal={reveal ? '' : undefined}
>
  <slot />
</Tag>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition:
        transform var(--duration-hover) ease-out,
        box-shadow var(--duration-hover) ease-out;
    }

    .card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-card-hover);
    }
  }
</style>
