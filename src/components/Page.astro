---
/**
 * Renders the full page for one locale: Navbar, Hero, About, Skills, Projects, Journey,
 * Achievements and Contact (with the footer), plus the "Beyond the code" dialog; every text comes from getContent().
 */
import About from './About.astro';
import Achievements from './Achievements.astro';
import Contact from './Contact.astro';
import Hero from './Hero.astro';
import Journey from './Journey.astro';
import Navbar from './Navbar.astro';
import PersonalPanel from './PersonalPanel.astro';
import Projects from './Projects.astro';
import Skills from './Skills.astro';
import Base from '../layouts/Base.astro';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale}>
  <Navbar locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <About locale={locale} />
    <Skills locale={locale} />
    <Projects locale={locale} />
    <Journey locale={locale} />
    <Achievements locale={locale} />
    <Contact locale={locale} />
  </main>
  <PersonalPanel locale={locale} />
</Base>
