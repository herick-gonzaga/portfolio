---
/**
 * Renders the full page for one locale. Section components replace the
 * placeholder sections below in later steps; every text comes from getContent().
 */
import Base from '../layouts/Base.astro';
import { getContent, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);

const sections = [
  { id: 'about', header: content.sections.about },
  { id: 'skills', header: content.sections.skills },
  { id: 'projects', header: content.sections.projects },
  { id: 'journey', header: content.sections.journey },
  { id: 'impact', header: content.sections.impact },
  { id: 'contact', header: content.sections.contact },
] as const;
---

<Base locale={locale}>
  <main id="main">
    <section id="hero" class="bg-ink text-white">
      <div class="container py-section">
        <h1 class="max-w-h1 text-h1 font-semibold">{content.profile.headline}</h1>
      </div>
    </section>
    {
      sections.map(({ id, header }) => (
        <section id={id} aria-labelledby={`${id}-kicker`}>
          <div class="container py-section">
            <p id={`${id}-kicker`} class="font-mono text-mono text-cobalt">
              {header.kicker}
            </p>
            {header.title && <h2 class="text-h2 font-semibold">{header.title}</h2>}
          </div>
        </section>
      ))
    }
  </main>
</Base>
