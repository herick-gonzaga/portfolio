---
/**
 * Renders the full page for one locale: Navbar, Hero, About and Skills, then placeholder sections that
 * section components replace in later steps; every text comes from getContent().
 */
import About from './About.astro';
import Hero from './Hero.astro';
import Navbar from './Navbar.astro';
import Skills from './Skills.astro';
import Base from '../layouts/Base.astro';
import { getContent, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);

const sections = [
  { id: 'projects', header: content.sections.projects },
  { id: 'journey', header: content.sections.journey },
  { id: 'impact', header: content.sections.impact },
  { id: 'contact', header: content.sections.contact },
] as const;
---

<Base locale={locale}>
  <Navbar locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <About locale={locale} />
    <Skills locale={locale} />
    {
      sections.map(({ id, header }) => (
        <section id={id} aria-labelledby={`${id}-kicker`}>
          <div class="container py-section">
            <p id={`${id}-kicker`} class="font-mono text-mono text-cobalt">
              {header.kicker}
            </p>
            {header.title && <h2 class="text-h2 font-semibold">{header.title}</h2>}
          </div>
        </section>
      ))
    }
  </main>
</Base>
