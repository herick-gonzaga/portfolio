---
/**
 * Contact section and site footer (07), on ink, id="contact".
 * Padding 120px top / 56px bottom (72 / 40 below 900px) under a 1px top line that fades
 * transparent → cobalt → transparent. From 900px two bottom-aligned columns with a 48px gap:
 * kicker, H2 (48px, 32px below 900px, max 16ch), text and CTAs on the left; the contact details
 * list on the right (label left, mono value right; label above value below 600px). CTAs are full
 * width below 600px. The footer row closes the section: copyright, tagline and "back to top".
 * After the time zone row, a live Brazil clock (America/Sao_Paulo, UTC−3 year-round) ticks every
 * second in mono; it renders "--:--:--" until the script runs, at the same width, so no shift.
 * Between the columns and the footer sits the interactive terminal (Terminal.astro).
 * It does not use the Section shell: the header and the details list share one grid row here.
 */
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import Kicker from './ui/Kicker.astro';
import Terminal from './Terminal.astro';
import { getContent, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { profile, ui, sections } = getContent(locale);
const { contact } = profile;
const external = { target: '_blank', rel: 'noopener' } as const;

const details = [
  { key: 'email', label: ui.contact.email, value: contact.email, href: `mailto:${contact.email}` },
  { key: 'linkedin', label: ui.contact.linkedin, value: contact.linkedinLabel, href: contact.linkedin, ...external },
  { key: 'github', label: ui.contact.github, value: contact.githubLabel, href: contact.github, ...external },
  { key: 'instagram', label: ui.contact.instagram, value: contact.instagramLabel, href: contact.instagram, ...external },
  { key: 'timezone', label: ui.contact.timezone, value: contact.timezone },
  { key: 'localtime', label: ui.contact.localTime, clock: true },
];
---

<section id="contact" aria-labelledby="contact-title" class="contact relative bg-ink text-white">
  <div
    class="absolute inset-x-0 top-0 h-px bg-[linear-gradient(to_right,transparent,var(--color-cobalt),transparent)]"
    aria-hidden="true"
  >
  </div>

  <div class="container">
    <div class="grid gap-12 md:grid-cols-2 md:items-end" data-reveal-group>
      <div class="min-w-0" data-reveal>
        <Kicker id="contact-kicker" tone="dark">{sections.contact.kicker}</Kicker>
        <h2
          id="contact-title"
          class="mt-4 max-w-[16ch] text-[32px] leading-[1.1] font-semibold tracking-[-0.02em] text-white md:text-[48px]"
        >
          {profile.contactHeadline}
        </h2>
        <p class="mt-6 max-w-[50ch] text-[17px] leading-[1.6] text-muted-dark">{profile.contactText}</p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button href={`mailto:${contact.email}`} magnetic class="w-full sm:w-auto">
            {ui.emailMe}
            <Icon slot="icon" name="arrow-right" size={18} />
          </Button>
          <Button href={contact.linkedin} variant="ghost-dark" class="w-full sm:w-auto" {...external}>
            {ui.linkedin}
          </Button>
        </div>
      </div>

      <ul class="min-w-0 border-t border-ink-line" data-contact-details data-reveal>
        {
          details.map(({ key, label, value, href, clock, ...attrs }) => (
            <li
              data-row={key}
              class="flex flex-col border-b border-ink-line pt-3 pb-1 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:py-1"
            >
              <span class="shrink-0 text-[14px] leading-[1.4] text-muted-dark">{label}</span>
              {clock ? (
                <span class="inline-flex min-h-touch min-w-0 items-center gap-2 font-mono text-[15px] leading-[1.4] text-white sm:text-right">
                  <time data-clock class="tabular-nums">--:--:--</time>
                  <span class="text-muted-dark">BRT</span>
                </span>
              ) : href ? (
                <a
                  href={href}
                  class="inline-flex min-h-touch min-w-0 items-center rounded-chip font-mono text-[15px] leading-[1.4] break-words text-white transition-colors duration-hover ease-out hover:text-cobalt-soft sm:text-right"
                  {...attrs}
                >
                  <span class="link-underline">{value}</span>
                </a>
              ) : (
                <span class="inline-flex min-h-touch min-w-0 items-center font-mono text-[15px] leading-[1.4] text-white sm:text-right">
                  {value}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <Terminal locale={locale} />

    <footer
      class="mt-16 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-ink-line pt-6 text-[13px] leading-[1.5] text-muted-dark md:mt-20"
    >
      <p>© 2026 {profile.fullName}</p>
      <p class="font-mono">{profile.footerTagline}</p>
      <a
        href="#top"
        class="inline-flex min-h-touch items-center gap-2 rounded-chip transition-colors duration-hover ease-out hover:text-white"
      >
        {ui.backTop}
        <Icon name="arrow-up" size={16} />
      </a>
    </footer>
  </div>
</section>

<script>
  // Live Brazil clock. Re-armed on each second boundary so it never drifts; browsers throttle
  // timers in background tabs, so it also catches up the moment the tab is shown again.
  const TIME_ZONE = 'America/Sao_Paulo';
  const clocks = document.querySelectorAll<HTMLTimeElement>('[data-clock]');

  if (clocks.length) {
    const format = new Intl.DateTimeFormat(document.documentElement.lang || undefined, {
      timeZone: TIME_ZONE,
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hourCycle: 'h23',
    });
    let timer = 0;
    const tick = () => {
      clearTimeout(timer);
      const now = new Date();
      const text = format.format(now);
      for (const clock of clocks) {
        clock.textContent = text;
        clock.dateTime = text;
      }
      timer = window.setTimeout(tick, 1000 - now.getMilliseconds() + 5);
    };
    tick();
    document.addEventListener('visibilitychange', () => document.hidden || tick());
  }
</script>

<style>
  .contact {
    padding-top: 72px;
    padding-bottom: 40px;
  }

  @media (min-width: 900px) {
    .contact {
      padding-top: 120px;
      padding-bottom: 56px;
    }
  }
</style>
