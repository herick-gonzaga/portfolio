---
/**
 * Small project card: mono kind, 18px title, 14px description and light chips.
 * The links row only renders when the project has links.
 */
import ProjectLinks from './ProjectLinks.astro';
import Card from './ui/Card.astro';
import Chip from './ui/Chip.astro';
import type { Content } from '../i18n';

interface Props {
  project: Content['projects'][number];
  class?: string;
}

const { project, class: className } = Astro.props;
---

<Card as="article" reveal class:list={['flex flex-col', className]}>
  <p class="font-mono text-mono-sm text-cobalt">{project.kind}</p>
  <h3 class="mt-3 text-[18px] leading-[1.3] font-semibold tracking-[-0.01em]">{project.name}</h3>
  <p class="mt-2 text-[14px] leading-[1.55] text-muted">{project.description}</p>
  <div class="mt-auto pt-5">
    <ul class="flex flex-wrap gap-[6px]">
      {
        project.stack.map((item) => (
          <li>
            <Chip>{item}</Chip>
          </li>
        ))
      }
    </ul>
    <ProjectLinks links={project.links} class="mt-3" />
  </div>
</Card>
