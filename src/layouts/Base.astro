---
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
// The latin variable files are the only ones the copy needs; preloading them lets the fonts
// download in parallel with the CSS instead of after it. Same files (and hashes) as the CSS uses.
import instrumentSansLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import jetbrainsMonoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

import { defaultLocale, getContent, htmlLang, localePath, locales, ogLocale, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Route path without the locale prefix. */
  path?: string;
}

const { locale, path = '/' } = Astro.props;
const content = getContent(locale);

// Absolute URLs need `site` in astro.config.mjs; until it is set, fall back to the request origin.
const base = Astro.site ?? Astro.url;
const absolute = (p: string) => new URL(p, base).href;

const canonical = absolute(localePath(locale, path));
/** 1200×630, generated by scripts/generate-assets.mjs. */
const ogImage = absolute('/og.png');

const alternates = [
  ...locales.map(({ code }) => ({ hreflang: htmlLang[code], href: absolute(localePath(code, path)) })),
  { hreflang: 'x-default', href: absolute(localePath(defaultLocale, path)) },
];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: content.profile.fullName,
  alternateName: content.profile.name,
  jobTitle: content.profile.title,
  description: content.meta.description,
  email: `mailto:${content.profile.contact.email}`,
  url: canonical,
  sameAs: [content.profile.contact.linkedin, content.profile.contact.github],
  inLanguage: htmlLang[locale],
};
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /*
       * First visit to "/" only: send pt/es browsers to their locale before anything paints.
       * Runs once (stores localStorage.lang) and is never rendered on /pt/ or /es/.
       */
      locale === defaultLocale && (
        <script is:inline>
          (function () {
            try {
              if (location.pathname !== '/' && location.pathname !== '/index.html') return;
              if (localStorage.getItem('lang')) return;
              var lang = (navigator.language || '').toLowerCase();
              var target = lang.indexOf('pt') === 0 ? 'pt' : lang.indexOf('es') === 0 ? 'es' : null;
              if (!target) return;
              localStorage.setItem('lang', target);
              location.replace('/' + target + '/' + location.hash);
            } catch (e) {
              // Storage unavailable: stay on English.
            }
          })();
        </script>
      )
    }
    <link rel="preload" href={instrumentSansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jetbrainsMonoLatin} as="font" type="font/woff2" crossorigin />
    <!-- Fixed palette: the site does not follow prefers-color-scheme. -->
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0F1420" />
    <title>{content.meta.title}</title>
    <meta name="description" content={content.meta.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={content.profile.name} />
    <meta property="og:title" content={content.meta.title} />
    <meta property="og:description" content={content.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {
      locales
        .filter(({ code }) => code !== locale)
        .map(({ code }) => <meta property="og:locale:alternate" content={ogLocale[code]} />)
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={content.meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={content.meta.title} />
    <meta name="twitter:description" content={content.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={content.meta.title} />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body class="bg-mist font-sans text-text">
    <slot />
  </body>
</html>
